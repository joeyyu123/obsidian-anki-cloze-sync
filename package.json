{
  "name": "obsidian-anki-cloze-sync",
  "version": "1.1.1",
  "description": "Sync Obsidian cloze, Q/A, choice, code practice, and image occlusion flashcards to Anki through AnkiConnect.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src",
    "preview:cards": "tsx scripts/render-card-preview.ts"
  },
  "keywords": [
    "obsidian",
    "anki",
    "flashcards",
    "cloze"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
